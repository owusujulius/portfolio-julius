rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedEmail() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'mensahayford777@gmail.com';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isUnchanged(field) {
      return request.resource.data[field] == resource.data[field];
    }

    // Validation Blueprints
    function isValidProject(data) {
      return data.keys().hasAll(['title', 'description', 'createdAt'])
        && data.title is string && data.title.size() <= 150
        && data.description is string && data.description.size() <= 5000
        && (resource == null ? data.createdAt == request.time : isUnchanged('createdAt'))
        && (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 1500000))
        && (!('techStack' in data) || (data.techStack is list && data.techStack.size() <= 30))
        && (!('liveUrl' in data) || (data.liveUrl is string && data.liveUrl.size() <= 1000))
        && (!('githubUrl' in data) || (data.githubUrl is string && data.githubUrl.size() <= 1000))
        && (!('updatedAt' in data) || data.updatedAt == request.time);
    }

    function isValidBlogPost(data) {
      return data.keys().hasAll(['title', 'content', 'status', 'createdAt'])
        && data.title is string && data.title.size() <= 250
        && data.content is string && data.content.size() <= 100000
        && data.status in ['draft', 'published']
        && (resource == null ? data.createdAt == request.time : isUnchanged('createdAt'))
        && (!('excerpt' in data) || (data.excerpt is string && data.excerpt.size() <= 1000))
        && (!('category' in data) || (data.category is string && data.category.size() <= 100))
        && (!('updatedAt' in data) || data.updatedAt == request.time);
    }

    function isValidMessage(data) {
      return data.keys().hasAll(['name', 'email', 'message', 'createdAt'])
        && data.name is string && data.name.size() <= 100
        && data.email is string && data.email.size() <= 100 && data.email.matches('^.+@.+$')
        && data.message is string && data.message.size() <= 5000
        && data.createdAt == request.time
        && (!('subject' in data) || (data.subject is string && data.subject.size() <= 200));
    }

    // Collections
    match /projects/{projectId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(projectId) && isValidProject(incoming()) && incoming().keys().size() <= 7;
      allow update: if isAdmin() && isValidId(projectId) && isValidProject(incoming())
        && incoming().diff(existing()).affectedKeys().hasAny(['title', 'description', 'imageUrl', 'techStack', 'liveUrl', 'githubUrl']);
      allow delete: if isAdmin();
    }

    match /posts/{postId} {
      allow read: if isAdmin() || (existing().status == 'published');
      allow list: if isAdmin() || (resource.data.status == 'published');
      allow create: if isAdmin() && isValidId(postId) && isValidBlogPost(incoming()) && incoming().keys().size() <= 6;
      allow update: if isAdmin() && isValidId(postId) && isValidBlogPost(incoming())
        && incoming().diff(existing()).affectedKeys().hasAny(['title', 'content', 'status', 'excerpt', 'category']);
      allow delete: if isAdmin();
    }

    match /messages/{messageId} {
      allow read: if isAdmin();
      allow create: if isValidId(messageId) && isValidMessage(incoming());
      allow update, delete: if isAdmin();
    }

    match /profile/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
