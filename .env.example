# Public Supabase configuration. These values are safe to expose to the browser.
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Node/Express server configuration.
PORT=3001
NODE_ENV=development
APP_URL="http://localhost:3001"

# Supabase migration script / server-only configuration.
SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_OWNER_ID="YOUR_SUPABASE_USER_UUID"

# Supabase Edge Function secrets (set with `supabase secrets set`).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
ALLOWED_ORIGIN="http://localhost:3001"

# Legacy Firebase export configuration. Use only for the one-time migration.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
